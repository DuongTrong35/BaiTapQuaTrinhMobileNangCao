<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen touchpad overlay -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/touchpad_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0A0A0F"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/touchpad_padding">

        <!-- Touchpad Area -->
        <View
            android:id="@+id/touchpad_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_remote_card" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/touchpad_hint"
            android:textAppearance="@style/TextAppearance.LGRemotePro.Caption"
            android:textColor="@color/text_secondary" />

        <!-- Close Touchpad Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_touchpad"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/close"
            android:textColor="@color/primary_accent"
            app:strokeColor="@color/primary_accent" />

    </LinearLayout>

</FrameLayout>
