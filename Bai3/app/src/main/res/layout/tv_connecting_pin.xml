<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Screen 1: Connecting -->
        <LinearLayout
            android:id="@+id/screen_connecting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp"
            android:gravity="center_horizontal"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="48dp">

                <ImageView
                    android:id="@+id/btn_back_connecting"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_outline"
                    android:src="@drawable/ic_back"
                    android:padding="8dp"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Wifi TV Remote"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Loading Radar -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginBottom="32dp">

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_circle_outline" />
                    
                <!-- Inner part -->

                <!-- We could have a spinning circular progress bar -->
                <ImageView
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_surface_circle"
                    android:padding="40dp"
                    android:src="@drawable/ic_radar_tv"
                    app:tint="@color/primary_accent" />

                <ImageView
                    android:id="@+id/iv_spinner"
                    android:layout_width="144dp"
                    android:layout_height="144dp"
                    android:layout_gravity="center"
                    android:src="@drawable/bg_custom_spinner" />

            </FrameLayout>

            <TextView
                android:id="@+id/tv_connecting_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang kết nối..."
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_connecting_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LG Smart TV"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_connecting_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.1.5"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="40dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_box"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_info_outline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Hướng dẫn"
                        android:textColor="@color/primary_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trên TV LG của bạn sẽ xuất hiện thông báo &quot;Cho phép kết nối?&quot; — hãy chọn Chấp nhận để tiếp tục."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_tv_accepted"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/selector_button_primary"
                android:text="TV đã chấp nhận \u2192"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginBottom="10dp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btn_enter_pin_alt"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button_outline"
                android:text="Nhập mã PIN thay thế"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@null" />

        </LinearLayout>

        <!-- Screen 2: PIN Input -->
        <LinearLayout
            android:id="@+id/screen_pin_input"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="48dp">

                <ImageView
                    android:id="@+id/btn_back_pin"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_outline"
                    android:src="@drawable/ic_back"
                    android:padding="8dp"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Nhập mã PIN"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_button_rect"
                android:src="@drawable/ic_lock"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                app:tint="@color/primary_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã PIN trên TV"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhìn vào màn hình LG Smart TV\nvà nhập mã 4 số hiển thị"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="32dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="32dp">

                <EditText
                    android:id="@+id/pin_1"
                    android:layout_width="52dp"
                    android:layout_height="60dp"
                    android:background="@drawable/selector_pin_box"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/pin_2"
                    android:layout_width="52dp"
                    android:layout_height="60dp"
                    android:background="@drawable/selector_pin_box"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/pin_3"
                    android:layout_width="52dp"
                    android:layout_height="60dp"
                    android:background="@drawable/selector_pin_box"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/pin_4"
                    android:layout_width="52dp"
                    android:layout_height="60dp"
                    android:background="@drawable/selector_pin_box"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_confirm_pin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/selector_button_primary"
                android:text="Xác nhận"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:enabled="false"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/tv_retry_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không thấy mã PIN?\nThử kết nối lại"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- Screen 3: Success -->
        <LinearLayout
            android:id="@+id/screen_success"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_success_circle"
                android:src="@drawable/ic_check"
                android:padding="26dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tv_success_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã kết nối!"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_success_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LG Smart TV"
                android:textColor="@color/primary_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_success_ip_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.1.5 · UHD 4K"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="48dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_box"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THÔNG TIN THIẾT BỊ"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tên TV"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_summary_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LG WebOS TV"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Địa chỉ IP"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_summary_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="192.168.1.5"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Trạng thái"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Online"
                        android:textColor="@color/success"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btn_open_remote"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/selector_button_primary"
                android:text="Mở Remote Control \u2192"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@null" />

        </LinearLayout>

    </FrameLayout>
</ScrollView>
