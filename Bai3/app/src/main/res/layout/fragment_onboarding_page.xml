<?xml version="1.0" encoding="utf-8"?>
<!-- Single onboarding page -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xxl">

    <ImageView
        android:id="@+id/img_onboarding"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:contentDescription="Onboarding illustration" />

    <TextView
        android:id="@+id/tv_onboarding_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxl"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.LGRemotePro.Display"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tv_onboarding_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.LGRemotePro.Body"
        android:textColor="@color/text_secondary" />

</LinearLayout>
