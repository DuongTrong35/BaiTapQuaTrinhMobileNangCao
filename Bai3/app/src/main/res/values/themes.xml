<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Main Dark Theme ────────────────────────────────── -->
    <style name="Theme.LGRemotePro" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_accent</item>
        <item name="colorPrimaryVariant">@color/secondary_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/bottom_nav_background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="bottomNavigationStyle">@style/Widget.LGRemotePro.BottomNav</item>
    </style>

    <!-- ── Onboarding Theme ───────────────────────────────── -->
    <style name="Theme.LGRemotePro.Onboarding" parent="Theme.LGRemotePro">
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- ── Bottom Navigation ──────────────────────────────── -->
    <style name="Widget.LGRemotePro.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/bottom_nav_background</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.LGRemotePro.BottomNav.ActiveIndicator</item>
    </style>

    <style name="Widget.LGRemotePro.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bottom_nav_indicator</item>
    </style>

    <!-- ── Button Styles ──────────────────────────────────── -->
    <style name="Widget.LGRemotePro.Button.Circle" parent="">
        <item name="android:layout_width">@dimen/btn_circle_size</item>
        <item name="android:layout_height">@dimen/btn_circle_size</item>
        <item name="android:background">@drawable/bg_button_circle</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/spacing_md</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.LGRemotePro.Button.Circle.Small" parent="Widget.LGRemotePro.Button.Circle">
        <item name="android:layout_width">@dimen/btn_circle_size_sm</item>
        <item name="android:layout_height">@dimen/btn_circle_size_sm</item>
    </style>

    <style name="Widget.LGRemotePro.Button.Circle.Large" parent="Widget.LGRemotePro.Button.Circle">
        <item name="android:layout_width">@dimen/btn_circle_size_lg</item>
        <item name="android:layout_height">@dimen/btn_circle_size_lg</item>
    </style>

    <style name="Widget.LGRemotePro.Button.Rect" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/btn_rect_height</item>
        <item name="android:background">@drawable/bg_button_rect</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ── Text Styles ────────────────────────────────────── -->
    <style name="TextAppearance.LGRemotePro.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LGRemotePro.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.LGRemotePro.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.LGRemotePro.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.LGRemotePro.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ── Card Style ─────────────────────────────────────── -->
    <style name="Widget.LGRemotePro.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- ── App Button Style (Netflix, YouTube, etc.) ───────── -->
    <style name="Widget.LGRemotePro.Button.App" parent="">
        <item name="android:layout_width">@dimen/app_btn_width</item>
        <item name="android:layout_height">@dimen/app_btn_height</item>
        <item name="android:background">@drawable/bg_button_rect</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>