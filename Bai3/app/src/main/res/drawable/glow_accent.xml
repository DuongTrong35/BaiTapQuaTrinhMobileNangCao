<?xml version="1.0" encoding="utf-8"?>
<!-- Neon glow effect for accent-colored buttons -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#3300C2FF" />
        </shape>
    </item>
    <!-- Inner button -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/button_normal" />
        </shape>
    </item>
</layer-list>
